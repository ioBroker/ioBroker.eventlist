{
    "$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
    "manifestVersion": 1,
    "tag": "iob-eventlist-events",
    "icon": "../eventlist.png",
    "module": "eventlist-events.js",
    "name": {
        "en": "Events",
        "de": "Ereignisse",
        "ru": "События",
        "pt": "Eventos",
        "nl": "Gebeurtenissen",
        "fr": "Événements",
        "it": "Eventi",
        "es": "Eventos",
        "pl": "Zdarzenia",
        "uk": "Події",
        "zh-cn": "事件"
    },
    "description": {
        "en": "The event list as a table",
        "de": "Die Ereignisliste als Tabelle",
        "ru": "Список событий в виде таблицы",
