{
  "name": "iobroker.eventlist",
  "version": "3.0.0",
  "description": "Builds and shows the event list from desired states in admin, web and as widget",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/bluefox/ioBroker.eventlist",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "event list",
    "events"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.eventlist.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "moment": "^2.30.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/moment": "^2.13.0",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.20.0",
    "blockly": "^13.2.1",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "src/main.ts",
  "files": [
    "admin/",
    "img/",
    "lib/",
    "src/",
    "widgets/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:package": "mocha test/package --exit --config test/mocharc.custom.json",
    "test:unit": "mocha test/unit \"test/*.test.ts\" --extension ts --exit --config test/mocharc.custom.json",
    "test:events": "mocha \"test/*.test.ts\" --extension ts --exit --config test/mocharc.custom.json",
    "test:integration": "mocha test/integration --exit --config test/mocharc.custom.json",
    "test": "npm run test:unit && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs && cd src-admin && npm run lint",
    "prepublishOnly": "tsc -p tsconfig.build.json && node tasks.js && npm run build:blockly",
    "build": "tsc -p tsconfig.build.json && node tasks.js && npm run build:blockly && npm run build:widgets && npm run build:admin",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i -f",
    "build:blockly": "tsc -p src-blockly/tsconfig.json && node src-blockly/build.mjs",
    "build:widgets": "node tasks.js --widgets",
    "build:admin": "node tasks.js --admin"
  },
  "bugs": {
    "url": "https://github.com/bluefox/ioBroker.eventlist/issues"
  },
  "readmeFilename": "README.md"
}
