{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The sources and the tests are checked, so the root is the project directory.
        // tsconfig.build.json overrides it with "./src" to build the adapter.
        "rootDir": "./",
        "allowJs": false,
        "types": ["node", "mocha"],
        "resolveJsonModule": true,
        "noEmitOnError": true,
        "sourceMap": true,
        "outDir": "./build/",
        "strict": true,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.js"],
    "exclude": ["node_modules/", "widgets/", "lib/"],
    "ts-node": {
        "transpileOnly": true
    }
}
